<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.hjq.bar.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/titleSize"
        android:background="@color/colorPrimary"
        app:leftIcon="@null"
        app:title="@string/app_name"
        app:titleColor="@color/white"
        app:titleStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.hjq.shape.layout.ShapeFrameLayout
                    android:id="@+id/sale"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_weight="1"
                    android:elevation="4dp"
                    app:shape_radius="8dp"
                    app:shape_solidColor="#66CC33">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Sale"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                </com.hjq.shape.layout.ShapeFrameLayout>

                <com.hjq.shape.layout.ShapeFrameLayout
                    android:id="@+id/_void"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:elevation="4dp"
                    app:shape_radius="8dp"
                    app:shape_solidColor="#3399FF">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Void"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                </com.hjq.shape.layout.ShapeFrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.hjq.shape.layout.ShapeFrameLayout
                    android:id="@+id/refund"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_weight="1"
                    android:elevation="4dp"
                    app:shape_radius="8dp"
                    app:shape_solidColor="#FFCC00">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Refund"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                </com.hjq.shape.layout.ShapeFrameLayout>

                <com.hjq.shape.layout.ShapeFrameLayout
                    android:id="@+id/transQuery"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:elevation="4dp"
                    app:shape_radius="8dp"
                    app:shape_solidColor="#607B8B">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Trans Query"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                </com.hjq.shape.layout.ShapeFrameLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.hjq.shape.layout.ShapeFrameLayout
                    android:id="@+id/auth"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_weight="1"
                    android:elevation="4dp"
                    app:shape_radius="8dp"
                    app:shape_solidColor="#009688">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Auth"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                </com.hjq.shape.layout.ShapeFrameLayout>

                <com.hjq.shape.layout.ShapeFrameLayout
                    android:id="@+id/capture"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:elevation="4dp"
                    app:shape_radius="8dp"
                    app:shape_solidColor="#3F51B5">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Capture"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                </com.hjq.shape.layout.ShapeFrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.hjq.shape.layout.ShapeFrameLayout
                    android:id="@+id/transListQuery"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_weight="1"
                    android:elevation="4dp"
                    app:shape_radius="8dp"
                    app:shape_solidColor="#FF6600">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Trans List Query"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                </com.hjq.shape.layout.ShapeFrameLayout>

                <com.hjq.shape.layout.ShapeFrameLayout
                    android:id="@+id/settlement"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:elevation="4dp"
                    app:shape_radius="8dp"
                    app:shape_solidColor="#66CC33">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Settlement"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                </com.hjq.shape.layout.ShapeFrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.hjq.shape.layout.ShapeFrameLayout
                    android:id="@+id/connectManage"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_weight="1"
                    android:elevation="4dp"
                    app:shape_radius="8dp"
                    app:shape_solidColor="#00BCD4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Connect Manage"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                </com.hjq.shape.layout.ShapeFrameLayout>

                <com.hjq.shape.layout.ShapeFrameLayout
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:elevation="4dp"
                    android:visibility="invisible"
                    app:shape_radius="8dp"
                    app:shape_solidColor="#66CC33">

                </com.hjq.shape.layout.ShapeFrameLayout>
            </LinearLayout>


        </LinearLayout>

    </ScrollView>


</LinearLayout>